{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": ["node"],
    "target": "ES2022"
  },
  "include": ["web/**/*.ts"]
}
