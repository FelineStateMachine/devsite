# Deployment settings for dev.site.
#
# DEVSITE_PUBLIC_ORIGIN pins account identity — Shoo derives client_id and each user's
# pairwise subject from it. Once anyone has signed in, changing this orphans every account.
export DEVSITE_PUBLIC_ORIGIN="https://dev.site"

# The control plane listens on loopback only. Cloudflare Tunnel is the only way in, so
# there is no port to expose or firewall.
export DEVSITE_BIND="127.0.0.1:4000"

export DEVSITE_DB="$DEVSITE_ROOT/data/devsite.db"
export DEVSITE_STATE_DIR="$DEVSITE_ROOT/data/state"
export DEVSITE_WEB_ROOT="$DEVSITE_ROOT/web"

# Hostnames served by the tunnel.
export DEVSITE_HOSTNAME="dev.site"
export DEVSITE_TUNNEL_NAME="devsite"

# Cloudflare zone holding dev.site. Not a secret — it only names the zone, and every API
# call against it still requires a token.
export CLOUDFLARE_ZONE_ID="f0b023d8e68dde02a0e9d3a3728fa890"
